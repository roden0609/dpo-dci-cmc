package hk.gov.cmc.webserver.rest;


import javax.naming.InitialContext;
import javax.xml.soap.SOAPMessage;

import org.apache.axis.Message;
import org.apache.axis.MessageContext;
import org.apache.axis.message.SOAPBodyElement;
import org.apache.axis.message.SOAPEnvelope;
import org.apache.axis.utils.XMLUtils;
import org.exolab.castor.xml.Unmarshaller;
import org.w3c.dom.Document;
import org.w3c.dom.NodeList;

import hk.gov.spica_scopes.common.utils.CastorUtils;
import hk.gov.spica_scopes.common.utils.SoapUtils;

import hk.gov.ogcio.mars_cmc.framework.common.webserver.axis.AxisBase;

import hk.gov.ogcio.mars_cmc.cmc.castor.retrievecmctemplate.RetrieveCmcTemplateRequest;
import hk.gov.ogcio.mars_cmc.cmc.castor.retrievecmctemplate.RetrieveCmcTemplateResponse;
import hk.gov.ogcio.mars_cmc.cmc.castor.retrievecmctemplate.types.Result;
import hk.gov.ogcio.mars_cmc.cmc.datatype.message.Constants;
import hk.gov.ogcio.mars_cmc.cmc.appserver.ejb.session.retrievecmctemplate.IRetrieveCmcTemplateSessionBM;

@WebService
public class RetrieveCmcTemplateRestProvider {

    public static final String APPID_TAG_NAME = "SenderAppId";

    public void processMessage(SOAPEnvelope request, SOAPEnvelope response) {
        logInfo("processMessage -- BEGIN");

        try {
            MessageContext mc = MessageContext.getCurrentContext();
            Message requestMsg = mc.getRequestMessage();
            Message responseMsg = mc.getResponseMessage();
            processRetrieveCmcTemplate(requestMsg, responseMsg);
            mc.setResponseMessage(responseMsg);

        } catch (Exception e) {
            logError("General exception caught in processMessage", e);
        }

        logInfo("processMessage -- END");
    }

    private SOAPMessage processRetrieveCmcTemplate(SOAPMessage requestMsg, SOAPMessage responseMsg) throws Exception {
        logInfo("processRetrieveCmcTemplate -- BEGIN");

        RetrieveCmcTemplateResponse response = null;
        try {
            String appId = null;
            SOAPEnvelope envelope = (SOAPEnvelope) requestMsg.getSOAPPart().getEnvelope();
            Document envDoc = envelope.getAsDocument();
            NodeList nodeList = envDoc.getElementsByTagName(APPID_TAG_NAME);
            if (nodeList != null && nodeList.getLength() > 0) {
                appId = nodeList.item(0).getFirstChild().getNodeValue();
            }

            SOAPBodyElement body = (SOAPBodyElement) SoapUtils.getFirstBodyElement(requestMsg);
            Document bodyDoc = body.getAsDocument();
            logDebug("Request body: " + XMLUtils.DocumentToString(bodyDoc));

            RetrieveCmcTemplateRequest retrieveCmcTemplateRequest = (RetrieveCmcTemplateRequest) Unmarshaller.unmarshal(RetrieveCmcTemplateRequest.class, bodyDoc);

            InitialContext ctx = new InitialContext();
            IRetrieveCmcTemplateSessionBM ejb = (IRetrieveCmcTemplateSessionBM) ctx.lookup("java:global/cmc/cmc_app/RetrieveCmcTemplateSessionEJB!hk.gov.ogcio.mars_cmc.cmc.appserver.ejb.session.retrievecmctemplate.IRetrieveCmcTemplateSessionBMLocal");
            response = ejb.processMessage(appId, retrieveCmcTemplateRequest);

            logInfo("processRetrieveCmcTemplate -- END");

        } catch (Exception ex) {
            logError("General exception caught in processRetrieveCmcTemplate", ex);
            return generateResponse(responseMsg, Result.VALUE_9999, ResultMessages.RESULT_MSG_RETRIEVE_CMC_TEMPLATE_9999);
        }

        return generateResponse(responseMsg, response);
    }

    private SOAPMessage generateResponse(SOAPMessage responseMsg, Result resultCd, String resultMsg) throws Exception {

        RetrieveCmcTemplateResponse response = new RetrieveCmcTemplateResponse();
        response.setResultCd(resultCd);
        response.setResultMsg(resultMsg);
        return generateResponse(responseMsg, response);
    }

    private SOAPMessage generateResponse(SOAPMessage responseMsg, RetrieveCmcTemplateResponse response) throws Exception {
        return CastorUtils.marshal(responseMsg, response);
    }
}