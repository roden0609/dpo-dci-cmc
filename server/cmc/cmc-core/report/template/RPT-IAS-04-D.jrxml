<jasperReport name="RPT-IAS-04-D" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="NoDataSection" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="36" bottomMargin="20" uuid="f3c66fc6-869b-4b37-8c9a-3f8ffd2f2a77">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="80"/>
	<property name="ireport.y" value="26"/>
	<parameter name="SUBREPORT_DIR" forPrompting="false" class="java.lang.String"/>
	<parameter name="REQUEST_DATE" class="java.lang.String"/>
	<parameter name="GEN_DATE" class="java.lang.String"/>
	<parameter name="SEARCH_BY_SPID" class="java.lang.String"/>
	<parameter name="SPID" class="java.lang.String"/>
	<query language="sql"><![CDATA[select csp.service_provider_name sp_name
from ias_message_stat ias, cmc_service_provider csp, cmc_template ct, cmc_template_type ctt
where ias.service_provider_id = csp.service_provider_id
and   DATE_FORMAT(ias.stat_date, '%d/%m/%Y') = $P{REQUEST_DATE}
and   ias.template_id = ct.template_id
and   ias.template_version = ct.template_version
and   ct.template_type = ctt.template_type
and   (ctt.type_ind = 'M' or ctt.type_ind = 'I' or ctt.type_ind = 'A')
$P!{SEARCH_BY_SPID}
group by csp.service_provider_name
order by sp_name asc]]></query>
	<field name="SP_NAME" class="java.lang.String"/>
