<jasperReport name="RPT_IAS_04_M_sub1" language="groovy" pageWidth="779" pageHeight="594" orientation="Landscape" whenNoDataType="NoDataSection" columnWidth="779" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="93c90892-d5e9-4872-839a-e08f4e858eef">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="SP_NAME" class="java.lang.String"/>
	<parameter name="REQUEST_MONTH" class="java.lang.String"/>
	<parameter name="START_DATE" class="java.lang.String"/>
	<parameter name="END_DATE" class="java.lang.String"/>
	<query language="sql"><![CDATA[select ims.template_id template_id, ims.template_version version,
sum(ims.no_of_message_created) sum_created, sum(ims.no_of_message_created_read) sum_read, sum(ims.no_of_message_created_unread) sum_unread, sum(ims.no_of_message_sent) sum_sent
from ias_message_stat ims, cmc_service_provider csp, cmc_template ct, cmc_template_type ctt
where ims.service_provider_id = csp.service_provider_id
and csp.service_provider_name = $P{SP_NAME}
and   DATE_FORMAT(ims.stat_date, '%Y%m') = $P{REQUEST_MONTH}
and   ims.template_id = ct.template_id
and   ims.template_version = ct.template_version
and   ct.template_type = ctt.template_type
and   (ctt.type_ind = 'M' or ctt.type_ind = 'I' or ctt.type_ind = 'A')
group by ims.template_id, ims.template_version
order by ims.template_id asc]]></query>
	<field name="TEMPLATE_ID" class="java.lang.String"/>
	<field name="VERSION" class="java.lang.String"/>
	<field name="SUM_CREATED" class="java.math.BigDecimal"/>
	<field name="SUM_READ" class="java.math.BigDecimal"/>
	<field name="SUM_UNREAD" class="java.math.BigDecimal"/>
	<field name="SUM_SENT" class="java.math.BigDecimal"/>
