	<property name="ireport.zoom" value="2.1435888100000016"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="SP_NAME" class="java.lang.String"/>
	<parameter name="REQUEST_DATE" class="java.lang.String"/>
	<queryString>
		<![CDATA[select ims.template_id template_id, ims.template_version version, ims.no_of_message_created msg_created, ims.no_of_message_created_read msg_read, ims.no_of_message_created_unread msg_unread, ims.no_of_message_sent msg_sent
from ias_message_stat ims, cmc_service_provider csp, cmc_template ct, cmc_template_type ctt
where ims.service_provider_id = csp.service_provider_id
and DATE_FORMAT(ims.stat_date, '%d/%m/%Y') = $P{REQUEST_DATE}
and   ims.template_id = ct.template_id
and   ims.template_version = ct.template_version
and   ct.template_type = ctt.template_type
and   (ctt.type_ind = 'M' or ctt.type_ind = 'I' or ctt.type_ind = 'A')
and csp.service_provider_name = $P{SP_NAME}]]>
	</queryString>
	<field name="TEMPLATE_ID" class="java.lang.String"/>
	<field name="VERSION" class="java.lang.String"/>
	<field name="MSG_CREATED" class="java.math.BigDecimal"/>
	<field name="MSG_READ" class="java.math.BigDecimal"/>
	<field name="MSG_UNREAD" class="java.math.BigDecimal"/>
	<field name="MSG_SENT" class="java.math.BigDecimal"/>
