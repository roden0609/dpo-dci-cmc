<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="RPT-IAS-10-D_sub" language="groovy" pageWidth="779" pageHeight="594" orientation="Landscape" columnWidth="779" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="7cbe7675-8e01-4cd1-b376-643a5bb8471b">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="SP_NAME" class="java.lang.String"/>
	<parameter name="REQUEST_DATE" class="java.lang.String"/>
	<queryString>
		<![CDATA[select iutdi.tran_id tran_id, iutdi.action_tran_id action_tran_id, 'Modify' action,
   DATE_FORMAT(iutdi.last_modify_dt, '%d/%m/%Y %H:%i:%s') update_dt, itdi.title_en subject
from ias_user_to_do_item iutdi, ias_to_do_item itdi, cmc_template ct, cmc_service_provider csp
where iutdi.ias_to_do_item_id = itdi.ias_to_do_item_id
and   itdi.template_id = ct.template_id
and   itdi.template_version = ct.template_version
and   ct.service_provider_id = csp.service_provider_id
and   DATE_FORMAT(iutdi.last_modify_dt, '%d/%m/%Y') = $P{REQUEST_DATE}
and   IFNULL(iutdi.delete_ind, 'Y') = 'Y'
and   iutdi.action_tran_id is not null
and csp.service_provider_name = $P{SP_NAME}
and   exists(
   select 'x'
   from ias_user_to_do_item iutdi1, ias_to_do_item itdi1
   where iutdi1.ias_to_do_item_id = itdi1.ias_to_do_item_id
   and   itdi1.template_id = itdi.template_id
   and   itdi1.template_version = itdi.template_version
   and   iutdi1.recipient_id = iutdi.recipient_id
   and   iutdi1.tran_id = iutdi.action_tran_id)
union
select iutdi.tran_id tran_id, iutdi.action_tran_id action_tran_id, 'Delete' action,
   DATE_FORMAT(iutdi.last_modify_dt, '%d/%m/%Y %H:%i:%s') update_dt, itdi.title_en subject
from ias_user_to_do_item iutdi, ias_to_do_item itdi, cmc_template ct, cmc_service_provider csp
where iutdi.ias_to_do_item_id = itdi.ias_to_do_item_id
and   itdi.template_id = ct.template_id
and   itdi.template_version = ct.template_version
and   ct.service_provider_id = csp.service_provider_id
and   DATE_FORMAT(iutdi.last_modify_dt, '%d/%m/%Y') = $P{REQUEST_DATE}
and   IFNULL(iutdi.delete_ind, 'Y') = 'Y'
and   iutdi.action_tran_id is not null
and csp.service_provider_name = $P{SP_NAME}
and   not exists(
   select 'x'
   from ias_user_to_do_item iutdi1, ias_to_do_item itdi1
   where iutdi1.ias_to_do_item_id = itdi1.ias_to_do_item_id
   and   itdi1.template_id = itdi.template_id
   and   itdi1.template_version = itdi.template_version
   and   iutdi1.recipient_id = iutdi.recipient_id
   and   iutdi1.tran_id = iutdi.action_tran_id)
union
select iutdi.tran_id tran_id, iutdi.action_tran_id action_tran_id, 'Mark Completed' action,
   DATE_FORMAT(iutdi.last_modify_dt, '%d/%m/%Y %H:%i:%s') update_dt, itdi.title_en subject
from ias_user_to_do_item iutdi, ias_to_do_item itdi, cmc_template ct, cmc_service_provider csp
where iutdi.ias_to_do_item_id = itdi.ias_to_do_item_id
and   itdi.template_id = ct.template_id
and   itdi.template_version = ct.template_version
and   ct.service_provider_id = csp.service_provider_id
and   DATE_FORMAT(iutdi.last_modify_dt, '%d/%m/%Y') = $P{REQUEST_DATE}
and   IFNULL(iutdi.complete_ind, 'I') = 'C'
and   iutdi.action_tran_id is not null
and csp.service_provider_name = $P{SP_NAME}
and   not exists(
   select 'x'
   from ias_user_to_do_item iutdi1, ias_to_do_item itdi1
   where iutdi1.ias_to_do_item_id = itdi1.ias_to_do_item_id
   and   itdi1.template_id = itdi.template_id
   and   itdi1.template_version = itdi.template_version
   and   iutdi1.recipient_id = iutdi.recipient_id
   and   iutdi1.tran_id = iutdi.action_tran_id)]]>
	</queryString>
	<field name="TRAN_ID" class="java.lang.String"/>
	<field name="ACTION_TRAN_ID" class="java.lang.String"/>
	<field name="ACTION" class="java.lang.String"/>
	<field name="UPDATE_DT" class="java.lang.String"/>
	<field name="SUBJECT" class="java.lang.String"/>
