<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="RPT_IAS_06" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="NoDataSection" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="36" bottomMargin="20" uuid="7580a59b-1748-4035-9610-c694243abb5a">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false"/>
	<parameter name="REQUEST_DATE" class="java.lang.String"/>
	<parameter name="GEN_DATE" class="java.lang.String"/>
	<parameter name="SEARCH_BY_SPID" class="java.lang.String"/>
	<parameter name="SPID" class="java.lang.String"/>
	<queryString>
		<![CDATA[select distinct csp.service_provider_name sp_name
from ias_user_message ium, ias_message im, ias_undelivered_message iudm, cmc_template ct, cmc_service_provider csp
where ium.ias_msg_id = im.ias_msg_id
and   ium.ias_msg_id = iudm.ias_msg_id
and   ium.client_id = iudm.client_id
and   ium.open_id = iudm.open_id
and   im.template_id = ct.template_id
and   im.template_version = ct.template_version
and   ct.service_provider_id = csp.service_provider_id
and   DATE_FORMAT(iudm.create_dt, '%d/%m/%Y') = $P{REQUEST_DATE}
and   iudm.status = 'N'
$P!{SEARCH_BY_SPID}
union
select distinct csp.service_provider_name sp_name
from ias_user_to_do_item iutdi, ias_to_do_item itdi, ias_undelivered_to_do_item iudtdi, cmc_template ct, cmc_service_provider csp
where iutdi.ias_to_do_item_id = itdi.ias_to_do_item_id
and   iutdi.ias_to_do_item_id = iudtdi.ias_to_do_item_id
and   iutdi.client_id = iudtdi.client_id
and   iutdi.recipient_id = iudtdi.recipient_id
and   itdi.template_id = ct.template_id
and   itdi.template_version = ct.template_version
and   ct.service_provider_id = csp.service_provider_id
and   DATE_FORMAT(iudtdi.create_dt, '%d/%m/%Y') = $P{REQUEST_DATE}
and   iudtdi.status = 'N'
$P!{SEARCH_BY_SPID}
union
select distinct csp.service_provider_name sp_name
from ias_user_application iua, ias_application ia, ias_undelivered_application iuda, cmc_template ct, cmc_service_provider csp
where iua.ias_application_id = ia.ias_application_id
and   iua.ias_application_id = iuda.ias_application_id
and   iua.client_id = iuda.client_id
and   iua.recipient_id = iuda.recipient_id
and   ia.template_id = ct.template_id
and   ia.template_version = ct.template_version
and   ct.service_provider_id = csp.service_provider_id
and   DATE_FORMAT(iuda.create_dt, '%d/%m/%Y') = $P{REQUEST_DATE}
and   iuda.status = 'N'
$P!{SEARCH_BY_SPID}
order by sp_name asc]]>
	</queryString>
	<field name="SP_NAME" class="java.lang.String"/>
