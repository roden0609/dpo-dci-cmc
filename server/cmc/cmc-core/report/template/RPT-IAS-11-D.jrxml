<jasperReport name="RPT-IAS-11-D" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="NoDataSection" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="36" bottomMargin="20" uuid="d1d7adfc-a9c2-4377-b175-62e0d6f93976">
	<property name="ireport.zoom" value="0.9982500000000003"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="SUBREPORT_DIR" forPrompting="false" class="java.lang.String"/>
	<parameter name="REQUEST_DATE" class="java.lang.String"/>
	<parameter name="GEN_DATE" class="java.lang.String"/>
	<parameter name="SEARCH_BY_SPID" class="java.lang.String"/>
	<parameter name="SPID" class="java.lang.String"/>
	<query language="sql"><![CDATA[select csp.service_provider_name sp_name
from ias_user_application iua, ias_application ia, cmc_template ct, cmc_service_provider csp
where iua.ias_application_id = ia.ias_application_id
and   ia.template_id = ct.template_id
and   ia.template_version = ct.template_version
and   ct.service_provider_id = csp.service_provider_id
and   iua.operation_type in ('u', 'r')
and   DATE_FORMAT(iua.create_dt, '%d/%m/%Y') = $P{REQUEST_DATE}
$P!{SEARCH_BY_SPID}
group by csp.service_provider_name
order by sp_name asc]]></query>
	<field name="SP_NAME" class="java.lang.String"/>
