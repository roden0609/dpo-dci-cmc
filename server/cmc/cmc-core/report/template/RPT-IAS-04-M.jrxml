<jasperReport name="RPT-IAS-04-M" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="NoDataSection" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="36" bottomMargin="20" uuid="1164a68b-5af1-4ed0-871e-8b83666eb3c5">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="SUBREPORT_DIR" forPrompting="false" class="java.lang.String"/>
	<parameter name="REQUEST_MONTH" class="java.lang.String"/>
	<parameter name="GEN_DATE" class="java.lang.String"/>
	<parameter name="START_DATE" class="java.lang.String"/>
	<parameter name="END_DATE" class="java.lang.String"/>
	<parameter name="SEARCH_BY_SPID" class="java.lang.String"/>
	<parameter name="SPID" class="java.lang.String"/>
	<query language="sql"><![CDATA[select csp.service_provider_name sp_name
from ias_message_stat ims, cmc_service_provider csp, cmc_template ct, cmc_template_type ctt
where ims.service_provider_id = csp.service_provider_id
and   DATE_FORMAT(ims.stat_date, '%Y%m') = $P{REQUEST_MONTH}
and   ims.template_id = ct.template_id
and   ims.template_version = ct.template_version
and   ct.template_type = ctt.template_type
and   (ctt.type_ind = 'M' or ctt.type_ind = 'I' or ctt.type_ind = 'A')
$P!{SEARCH_BY_SPID}
group by csp.service_provider_name
order by csp.service_provider_name asc]]></query>
	<field name="SP_NAME" class="java.lang.String">
		<description><![CDATA[]]></description>
	</field>
