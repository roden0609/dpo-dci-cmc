<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="RPT-IAS-11-D_sub" language="groovy" pageWidth="779" pageHeight="594" orientation="Landscape" columnWidth="779" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="9452c8b3-7336-4924-80ad-3abd4688825c">
	<property name="ireport.zoom" value="2.8531167061100033"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="SP_NAME" class="java.lang.String"/>
	<parameter name="REQUEST_DATE" class="java.lang.String"/>
	<queryString>
		<![CDATA[select iua.tran_id tran_id, iua.app_ref_num app_ref_num, iua.operation_type operation_type,
   DATE_FORMAT(iua.last_modify_dt, '%d/%m/%Y %H:%i:%s') update_dt, ia.title_en subject
from ias_user_application iua, ias_application ia, cmc_template ct, cmc_service_provider csp
where iua.ias_application_id = ia.ias_application_id
and   ia.template_id = ct.template_id
and   ia.template_version = ct.template_version
and   ct.service_provider_id = csp.service_provider_id
and   iua.operation_type in ('u', 'r')
and   DATE_FORMAT(iua.create_dt, '%d/%m/%Y') = $P{REQUEST_DATE}
and csp.service_provider_name = $P{SP_NAME}]]>
	</queryString>
	<field name="TRAN_ID" class="java.lang.String"/>
	<field name="APP_REF_NUM" class="java.lang.String"/>
	<field name="OPERATION_TYPE" class="java.lang.String"/>
	<field name="UPDATE_DT" class="java.lang.String"/>
	<field name="SUBJECT" class="java.lang.String"/>
