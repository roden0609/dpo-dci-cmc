<!-- Created with Jaspersoft Studio version 7.0.0.final using JasperReports Library version 7.0.0-b478feaa9aab4375eba71de77b4ca138ad2f62aa  -->
<jasperReport name="rpt_ias_06_sub" language="groovy" pageWidth="779" pageHeight="594" orientation="Landscape" whenNoDataType="NoDataSection" columnWidth="779" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="f0d312e9-11f8-43fb-abde-fe5ffb0adee9">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="SP_NAME" class="java.lang.String"/>
	<parameter name="REQUEST_DATE" class="java.lang.String"/>
	<query language="sql"><![CDATA[select ium.tran_id tran_id, DATE_FORMAT(ium.create_dt, '%d/%m/%Y %H:%i:%s') create_dt, im.subject_en title, iudm.reason reason, 
		IF(rcpt_type='I', 'iAM Smart Open ID', 'My ID') as undeliver_type
		from ias_user_message ium, ias_message im, ias_undelivered_message iudm, cmc_template ct, cmc_service_provider csp
		where ium.ias_msg_id = im.ias_msg_id
		and   ium.ias_msg_id = iudm.ias_msg_id
		and   ium.client_id = iudm.client_id
		and   ium.open_id = iudm.open_id
		and   im.template_id = ct.template_id
		and   im.template_version = ct.template_version
		and   ct.service_provider_id = csp.service_provider_id
		and   DATE_FORMAT(iudm.create_dt, '%d/%m/%Y') = $P{REQUEST_DATE}
		and   iudm.status = 'N'
		and csp.service_provider_name = $P{SP_NAME}
		union
		select iutdi.tran_id tran_id, DATE_FORMAT(iutdi.create_dt, '%d/%m/%Y %H:%i:%s') create_dt, itdi.title_en title, iudtdi.reason reason, 
		CASE 
           WHEN rcpt_type = 'I' AND iudtdi.recipient_id_type = 'OpenID' THEN 'iAM Smart Open ID'
           WHEN rcpt_type = 'I' THEN 'HKID'
           ELSE 'My ID'
       	END as undeliver_type
		from ias_user_to_do_item iutdi, ias_to_do_item itdi, ias_undelivered_to_do_item iudtdi, cmc_template ct, cmc_service_provider csp
		where iutdi.ias_to_do_item_id = itdi.ias_to_do_item_id
		and   iutdi.ias_to_do_item_id = iudtdi.ias_to_do_item_id
		and   iutdi.client_id = iutdi.client_id
		and   iutdi.recipient_id = iutdi.recipient_id
		and   itdi.template_id = ct.template_id
		and   itdi.template_version = ct.template_version
		and   ct.service_provider_id = csp.service_provider_id
		and   DATE_FORMAT(iutdi.create_dt, '%d/%m/%Y') = $P{REQUEST_DATE}
		and   iudtdi.status = 'N'
		and csp.service_provider_name = $P{SP_NAME}
		union
		select iua.tran_id tran_id, DATE_FORMAT(iua.create_dt, '%d/%m/%Y %H:%i:%s') create_dt, ia.title_en title, iuda.reason reason, 
		CASE 
           WHEN rcpt_type = 'I' AND iuda.recipient_id_type = 'OpenID' THEN 'iAM Smart Open ID'
           WHEN rcpt_type = 'I' THEN 'HKID'
           ELSE 'My ID'
       	END as undeliver_type
		from ias_user_application iua, ias_application ia, ias_undelivered_application iuda, cmc_template ct, cmc_service_provider csp
		where iua.ias_application_id = ia.ias_application_id
		and   iua.ias_application_id = iuda.ias_application_id
		and   iua.client_id = iua.client_id
		and   iua.recipient_id = iua.recipient_id
		and   ia.template_id = ct.template_id
		and   ia.template_version = ct.template_version
		and   ct.service_provider_id = csp.service_provider_id
		and   DATE_FORMAT(iua.create_dt, '%d/%m/%Y') = $P{REQUEST_DATE}
		and   iuda.status = 'N'
		and csp.service_provider_name = $P{SP_NAME}
		order by create_dt]]></query>
